  "rules": {
    "dark": {
      "tile": "authored tile mixed 3.5% toward ink",
      "tileBack": "authored tileBack mixed 5% toward ink",
      "raised": "authored tileBack mixed 12% toward ink"
    },
    "light": {
      "ground": "authored ground nudged 25% toward line",
      "tile": "white",
      "tileBack": "authored tile",
      "raised": "white"
    }
  },
  "elevation": {
    "dark": {
      "tile": "inset 0 1px 0 rgba(255,255,255,.09),inset 0 0 0 1px rgba(255,255,255,.065),0 2px 4px rgba(0,0,0,.45),0 14px 32px -12px rgba(0,0,0,.75)",
      "raised": "inset 0 1px 0 rgba(255,255,255,.1),0 0 0 1px color-mix(in srgb,var(--j-accent) 40%,transparent),0 28px 64px -14px rgba(0,0,0,.85),0 6px 16px rgba(0,0,0,.5)"
    },
    "light": {
      "tile": "inset 0 0 0 1px rgba(46,31,39,.07),0 1px 2px rgba(46,31,39,.08),0 14px 30px -14px rgba(58,29,46,.30)",
      "raised": "0 0 0 1px color-mix(in srgb,var(--j-accent) 30%,transparent),0 28px 64px -16px rgba(58,29,46,.40),0 6px 16px -4px rgba(58,29,46,.18)"
    }
  },
  "motion": {
    "ease": "cubic-bezier(.1,.9,.2,1)",
    "duration": { "base": "600ms", "exit": "170ms", "flip": "900ms" }
  },
  "type": {
    "family": "'Geist',system-ui,-apple-system,'Segoe UI',sans-serif",
