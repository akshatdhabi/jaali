      "tileNumber": { "weight": 240, "size": "clamp(44px,4.6vw,72px)", "tracking": "-.055em", "leading": ".9" },
      "pivot": { "weight": 330, "size": "clamp(26px,2.8vw,38px)", "tracking": "-.035em", "leading": "1.2" },
      "body": { "weight": 400, "size": "16px", "tracking": "0", "leading": "1.55" },
      "caption": { "weight": 400, "size": "13.5px", "tracking": ".005em", "leading": "1.5" }
