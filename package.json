{
  "name": "jaali",
  "version": "0.1.0",
  "description": "A small design system: thin lowercase type, hairlines, live tiles and a lattice background. CSS tokens plus vanilla JS.",
  "type": "module",
  "license": "MIT",
  "author": "Akshat Dhabi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akshatdhabi/jaali.git"
  },
  "homepage": "https://akshatdhabi.github.io/jaali/",
  "bugs": {
    "url": "https://github.com/akshatdhabi/jaali/issues"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "css",
    "typography",
    "theming",
    "dark-mode",
    "lattice",
    "jaali",
    "vanilla-js"
  ],
  "style": "dist/jaali.css",
  "main": "dist/jaali.js",
  "module": "dist/jaali.js",
  "types": "dist/jaali.d.ts",
  "exports": {
    ".": {
      "types": "./dist/jaali.d.ts",
      "import": "./dist/jaali.js",
      "default": "./dist/jaali.js"
    },
    "./css": "./dist/jaali.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./iife": "./dist/jaali.iife.js",
    "./package.json": "./package.json",
    "./fonts.css": "./dist/fonts.css",
    "./fonts/*": "./dist/fonts/*"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "audit": "node scripts/audit.mjs",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs",
    "docs": "node scripts/build.mjs && node scripts/serve.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
